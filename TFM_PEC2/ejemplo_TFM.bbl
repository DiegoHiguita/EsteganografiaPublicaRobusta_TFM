      \field{issn}{0165-1684}
      \field{journaltitle}{Signal Processing}
      \field{month}{2}
      \field{shortjournal}{Signal Processing}
      \field{title}{Algorithm of error-free information embedding into the {DCT} domain of digital images based on the {QIM} method using adaptive masking of distortions}
