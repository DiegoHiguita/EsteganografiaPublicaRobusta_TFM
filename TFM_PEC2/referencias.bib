	langid = {english},
	note = {Google-Books-{ID}: {ClxqCQAAQBAJ}},
	keywords = {Computers / General, Computers / Information Technology, Computers / Networking / General, Computers / Operating Systems / General, Computers / Security / Cryptography \& Encryption, Computers / Social Aspects, Law / Science \& Technology, Social Science / General},
}

